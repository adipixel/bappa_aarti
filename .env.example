# Show the audio player and the "has recording" badges.
#
# Off by default: the recordings are currently served over plain HTTP, which
# browsers block on an HTTPS page. Set this to true once they are reachable
# over HTTPS (either on the original host or wherever you move them), and
# update AUDIO_BASE in scripts/build-data.mjs if the location changed.
#
# Audio always streams — it is deliberately never cached for offline use.
VITE_AUDIO_ENABLED=false
